{
  "name": "us-equity-research-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "个人自用的美股投研、持仓跟踪与多周期预测工作台",
  "scripts": {
    "start": "node scripts/service.js start",
    "start:foreground": "node --env-file-if-exists=.env src/server.js",
    "stop": "node scripts/service.js stop",
    "restart": "node scripts/service.js restart",
    "service:status": "node scripts/service.js status",
    "service:uninstall": "node scripts/service.js uninstall",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "setup:futu": "python3 -m venv .venv-futu && .venv-futu/bin/python -m pip install -r requirements-futu.txt",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
