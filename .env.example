# Web application
APP_HOST=127.0.0.1
APP_PORT=3789
APP_TIMEZONE=Asia/Shanghai
DATABASE_PATH=./data/research.sqlite

# Free-first quote provider. Supported: yahoo, manual
MARKET_DATA_PROVIDER=yahoo
MARKET_REFRESH_INTERVAL_MINUTES=30
DAILY_REVIEW_HOUR_ET=18
DAILY_REVIEW_MINUTE_ET=15

# SEC EDGAR requires an identifying User-Agent with a real contact email.
# Example: SEC_USER_AGENT=Your Name your-email@example.com
SEC_USER_AGENT=
SEC_REQUESTS_PER_SECOND=5

# Analyst consensus estimates. Free keys currently support limited daily requests.
ALPHA_VANTAGE_API_KEY=

# Read-only Futu OpenD intraday quote collection. Start and log in to OpenD first.
FUTU_ENABLED=true
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111
FUTU_PYTHON_PATH=./.venv-futu/bin/python
# RTH = regular US session; ETH = extended hours; ALL = both.
FUTU_MARKET_SESSION=RTH
FUTU_BACKFILL_DAYS=35
# Raw ticks are auditable but large; minute aggregates are retained separately.
FUTU_TICK_RETENTION_DAYS=7
# Batch incoming events and persist no more than two flow snapshots per minute.
FUTU_INGEST_BATCH_MILLISECONDS=2000
FUTU_SNAPSHOT_INTERVAL_SECONDS=30
FUTU_HEALTH_CHECK_SECONDS=30
FUTU_HEARTBEAT_TIMEOUT_SECONDS=120
FUTU_RECONNECT_MAX_SECONDS=300

# Local database maintenance and backups.
DATABASE_BACKUP_RETENTION_COUNT=7
DATABASE_WARNING_MB=512
SYSTEM_MAINTENANCE_CHECK_MINUTES=60

# Notifications
MACOS_NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# OpenAI-compatible cloud LLM. Keep secrets in .env only.
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Prediction publication gate
RELIABILITY_GATE=85
