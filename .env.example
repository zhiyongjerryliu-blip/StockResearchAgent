# Web application
APP_HOST=127.0.0.1
APP_PORT=3789
APP_TIMEZONE=Asia/Shanghai
DATABASE_PATH=./data/research.sqlite

# Free-first quote provider. Supported: yahoo, manual
MARKET_DATA_PROVIDER=yahoo
MARKET_REFRESH_INTERVAL_MINUTES=30
DAILY_REVIEW_HOUR_ET=18
DAILY_REVIEW_MINUTE_ET=15

# SEC EDGAR requires an identifying User-Agent with a real contact email.
# Example: SEC_USER_AGENT=Your Name your-email@example.com
SEC_USER_AGENT=
SEC_REQUESTS_PER_SECOND=5

# Notifications
MACOS_NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# OpenAI-compatible cloud LLM. Keep secrets in .env only.
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Prediction publication gate
RELIABILITY_GATE=85
